/* ---------------------------------------------------------
   COLORS  — the colour names used by the other files (@bg, @accent …)
   come from a theme in themes/.

   Vague is the default. The theme picked with theme.sh is linked at
   ~/.local/state/basic-hypr/rofi-theme.rasinc and loaded on top;
   the leading ? means: skip it quietly if it does not exist yet.
   --------------------------------------------------------- */

@import "themes/vague"
?import "~/.local/state/basic-hypr/rofi-theme.rasinc"

* {
    /* every widget starts transparent with normal text,
       so only the things we style get a colour */
    background-color: transparent;
    text-color:       @fg;
}
